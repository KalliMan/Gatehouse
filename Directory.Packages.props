<Project>
  <!--
    Central package management: every NuGet version lives here.
    In a .csproj write only <PackageReference Include="Name" /> (no Version).
    Before adding a package, check its licence: permissive only (MIT, Apache-2.0, BSD), no commercial tiers.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Accounts">
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />                        <!-- Apache-2.0 -->
    <PackageVersion Include="MailKit" Version="4.18.2" />                                             <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.14" />       <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.14" />         <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.14" /> <!-- MIT -->
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />                                   <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />  <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />                      <!-- MIT -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />             <!-- MIT -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />                             <!-- MIT -->
    <PackageVersion Include="xunit" Version="2.9.3" />                                                <!-- Apache-2.0 -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />                            <!-- Apache-2.0 -->
  </ItemGroup>
</Project>
